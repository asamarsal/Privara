USDT0_TOKEN_ADDRESS=0x9d361B93A298CEe2bd3Ad85318EC82efe1aFdaC2

# -----------------------------------------------------------------------------
# FCC Configuration
# -----------------------------------------------------------------------------
FCC_MODE=local_mock
FCC_EXTENSION_ID=
FCC_API_URL=http://localhost:3300/fcc
# Local fixture signer only. Never fund or grant unrelated authority to this address.
MOCK_FCC_SIGNER_PRIVATE_KEY=your_local_fixture_key_here
PRIVARA_AUTHORIZED_ATTESTATION_SIGNER=0x926B8e37cC5267185b548fB1d15f50Da2671015a
PRIVARA_VERIFIER_ADAPTER_ADDRESS=0xa05A5c13A3206B1b357EE2F7C576790428690992

# -----------------------------------------------------------------------------
# Backend Matcher Configuration
# -----------------------------------------------------------------------------
VAULT_CONTRACT_ADDRESS=0x295ACfEce01513a360EA54768eB6efAf337a303E
VAULT_DEPLOY_BLOCK=33902106
# Backend refuses to start unless this is v2.
DEPLOYMENT_VERSION=v2
MATCHER_PRIVATE_KEY=
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=120000
# Reject stale/future FTSO observations and orders too close to expiry.
ORACLE_MAX_AGE_SECONDS=300
MIN_SETTLEMENT_WINDOW_SECONDS=30
PORT=3001
LOG_LEVEL=info

# Optional owner-mint script inputs (never put recipient private keys here)
DEMO_RECIPIENT=
DEMO_TOKEN_SYMBOL=FXRP
DEMO_MINT_AMOUNT=1000

